<Window x:Class="SistemPaneli.AyarPenceresi"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem Paneli · Ayarlar"
        Width="580" Height="760" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#12141B" Foreground="#F0F2F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Soluk" Color="#99A0AE" />
        <SolidColorBrush x:Key="Kutu" Color="#1B1E28" />
        <SolidColorBrush x:Key="KutuCizgi" Color="#2C3140" />

        <Style x:Key="Bolum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Vurgu}" />
            <Setter Property="Margin" Value="0,26,0,10" />
        </Style>
        <Style x:Key="Aciklama" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Soluk}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F2F7" />
            <Setter Property="Margin" Value="0,0,18,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Kutu}" />
            <Setter Property="Foreground" Value="#F0F2F7" />
            <Setter Property="BorderBrush" Value="{StaticResource KutuCizgi}" />
            <Setter Property="CaretBrush" Value="#F0F2F7" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F0F2F7" />
            <Setter Property="Background" Value="#252A37" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Zemin" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{StaticResource KutuCizgi}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Zemin" Property="Background" Value="#303747" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Zemin" Property="Background" Value="#3A4256" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,28">

            <!-- Görünüm -->
            <TextBlock Style="{StaticResource Bolum}" Text="GÖRÜNÜM" />
            <TextBlock Text="Vurgu rengi" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="Renkler">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBox x:Name="RenkKutusu" Width="92" Margin="6,0,0,0" ToolTip="Kendi rengin (#RRGGBB)" />
            </StackPanel>

            <DockPanel Margin="0,18,0,0">
                <TextBlock x:Name="KoyulukDegeri" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <TextBlock Text="Kart koyuluğu" />
            </DockPanel>
            <Slider x:Name="Koyuluk" Minimum="0" Maximum="90" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True"
                    TickFrequency="1" Margin="0,6,0,0" />
            <CheckBox x:Name="Bulaniklik" Content="Arka planı bulanıklaştır (buzlu cam)" Margin="0,14,0,0" />

            <!-- Widget'lar -->
            <TextBlock Style="{StaticResource Bolum}" Text="WIDGET'LAR" />
            <WrapPanel x:Name="WidgetKutulari" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="DuzenleDugmesi" Click="Duzenle_Click" />
                <Button Content="Konumları sıfırla" Click="Sifirla_Click" />
            </StackPanel>
            <TextBlock Style="{StaticResource Aciklama}" Margin="0,10,0,0"
                       Text="Düzenleme açıkken widget'ları farenin sol tuşuyla sürükleyebilirsin; birbirlerine ve ekran kenarına yaklaşınca hizalanırlar. Bitince düzenlemeyi kapat; kilitliyken tıklamalar arkadaki masaüstüne geçer." />

            <!-- Fanlar ve diskler -->
            <TextBlock Style="{StaticResource Bolum}" Text="FANLAR VE DİSKLER" />
            <TextBlock Style="{StaticResource Aciklama}" Margin="0,0,0,10"
                       Text="Soğutma kartında görünecek adlar. Boş bırakırsan sensörün kendi adı kullanılır; hiç dönmemiş fan yuvaları listelenmez." />
            <Grid x:Name="Sensorler" />

            <!-- Başlangıç -->
            <TextBlock Style="{StaticResource Bolum}" Text="BAŞLANGIÇ" />
            <CheckBox x:Name="Baslangic" Content="Windows açılınca başlat" />
            <TextBlock x:Name="BaslangicNotu" Style="{StaticResource Aciklama}" Visibility="Collapsed" />

            <!-- Hakkında -->
            <TextBlock Style="{StaticResource Bolum}" Text="HAKKINDA" />
            <TextBlock x:Name="Surum" />
            <TextBlock Style="{StaticResource Aciklama}" Margin="0,6,0,0"
                       Text="Kullanılan açık kaynak bileşenler: LibreHardwareMonitor (MPL-2.0), PresentMon (MIT), PawnIO (GPL-2.0). Lisans metinleri kurulum klasöründeki 'lisanslar' klasöründe." />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Günlük dosyasını aç" Click="Gunluk_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
